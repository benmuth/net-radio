#!/bin/bash
# Mock gpioget for testing
# Reads GPIO state from test/mock-gpio/<pin> files
# Usage: gpioget <chip> <pin>  (chip is ignored)

PIN="$2"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
MOCK_DIR="$SCRIPT_DIR/mock-gpio"
FILE="$MOCK_DIR/$PIN"

if [[ -f "$FILE" ]]; then
    cat "$FILE"
else
    if [[ "$PIN" == "17" ]]; then echo "1"; else echo "0"; fi
fi
