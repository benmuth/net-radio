#cloud-config

hostname: netradio-vm

users:
  - name: user
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
      - SSH_PUBKEY_PLACEHOLDER

package_update: true
packages:
  - ffmpeg
  - curl
  - golang
  - git

write_files:
  - path: /usr/local/bin/gpioget
    permissions: '0755'
    content: |
      #!/bin/bash
      PIN="$2"
      MOCK_DIR="$HOME/net-radio/test/mock-gpio"
      FILE="$MOCK_DIR/$PIN"
      if [[ -f "$FILE" ]]; then
          cat "$FILE"
      else
          if [[ "$PIN" == "17" ]]; then echo "1"; else echo "0"; fi
      fi

  - path: /home/user/setup-netradio.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -e
      mkdir -p ~/net-radio/test/mock-gpio
      echo "1" > ~/net-radio/test/mock-gpio/17
      echo "0" > ~/net-radio/test/mock-gpio/27
      echo "net-radio VM ready. Copy project to /home/user/net-radio"

runcmd:
  - mkdir -p /home/user/net-radio/test/mock-gpio
  - echo "1" > /home/user/net-radio/test/mock-gpio/17
  - echo "0" > /home/user/net-radio/test/mock-gpio/27
  - chown -R user:user /home/user
